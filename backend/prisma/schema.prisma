// Prisma Schema — BIETMI ERP

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  commercial
  purchasing
  accountant
}

enum PartnerType {
  customer
  supplier
}

enum PartnerCurrency {
  DZD
  FOREIGN
}

model User {
  id                 String   @id @default(uuid()) @db.Uuid
  username           String   @unique
  passwordHash       String   @map("password_hash")
  role               Role
  fullName           String   @map("full_name")
  isActive           Boolean  @default(true) @map("is_active")
  mustChangePassword Boolean  @default(true) @map("must_change_password")
  email              String?  @unique @map("email")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  createdInvoices      Invoice[]
  createdPurchaseOrders PurchaseOrder[]
  createdQuotes        Quote[]
  passwordResetTokens  PasswordResetToken[]

  @@map("users")
}

model Partner {
  id                 String          @id @default(uuid()) @db.Uuid
  type               PartnerType     @default(customer)
  name               String
  commercialRegister String?         @map("commercial_register")
  nif                String?         @unique
  address            String?
  paymentTerms       String?         @map("payment_terms")
  currency           PartnerCurrency @default(DZD)
  isActive           Boolean         @default(true) @map("is_active")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  contacts  Contact[]
  invoices  Invoice[]
  purchaseOrders PurchaseOrder[]
  quotes Quote[]

  @@map("partners")
}

model Contact {
  id        String  @id @default(uuid()) @db.Uuid
  partnerId String  @map("partner_id") @db.Uuid
  name      String
  phone     String?
  email     String?
  position  String?
  isPrimary Boolean @default(false) @map("is_primary")

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@map("contacts")
}

enum InvoiceStatus {
  draft
  issued
  partially_paid
  paid
  overdue
}

model Invoice {
  id                String        @id @default(uuid()) @db.Uuid
  invoiceNumber     String?       @unique @map("invoice_number")
  partnerId         String        @map("partner_id") @db.Uuid
  createdByUserId   String        @map("created_by_user_id") @db.Uuid
  issueDate         DateTime      @default(now()) @map("issue_date")
  dueDate           DateTime?     @map("due_date")
  status            InvoiceStatus @default(draft)
  subtotal          Decimal       @db.Decimal(12, 2)
  discountPercent   Decimal       @default(0) @map("discount_percent") @db.Decimal(5, 2)
  discountAmount    Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  tvaAmount         Decimal       @map("tva_amount") @db.Decimal(12, 2)
  totalAmount       Decimal       @map("total_amount") @db.Decimal(12, 2)
  paymentMethods Json?        @map("payment_methods")
  objet             String?       @map("objet")
  internalReference String?       @map("internal_reference")
  projectId         String?       @map("project_id") @db.Uuid
  paymentStage      String?       @map("payment_stage")
  equipmentId       String?       @map("equipment_id") @db.Uuid
  quoteId           String?       @unique @map("quote_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  partner  Partner        @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  createdBy User          @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  lines    InvoiceLine[]
  quote    Quote?         @relation("invoiceQuote", fields: [quoteId], references: [id], onDelete: SetNull)
  convertedQuote Quote?   @relation("quoteConversion")

  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  description String
  unit        String?
  quantity    Decimal @db.Decimal(12, 3)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 3)
  lineTotal   Decimal @map("line_total") @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_lines")
}

model InvoiceCounter {
  id         String @id @default(uuid()) @db.Uuid
  year       Int
  lastNumber Int    @default(0) @map("last_number")

  @@unique([year])
  @@map("invoice_counters")
}

enum QuoteStatus {
  draft
  sent
  accepted
  rejected
  revision_requested
}

model Quote {
  id                   String      @id @default(uuid()) @db.Uuid
  quoteNumber          String      @unique @map("quote_number")
  partnerId            String      @map("partner_id") @db.Uuid
  createdByUserId      String      @map("created_by_user_id") @db.Uuid
  status               QuoteStatus @default(draft)
  objet                String?     @map("objet")
  subtotal             Decimal     @db.Decimal(12, 2)
  discountPercent      Decimal     @default(0) @map("discount_percent") @db.Decimal(5, 2)
  discountAmount       Decimal     @default(0) @map("discount_amount") @db.Decimal(12, 2)
  tvaAmount            Decimal     @map("tva_amount") @db.Decimal(12, 2)
  totalAmount          Decimal     @map("total_amount") @db.Decimal(12, 2)
  paymentMethods       Json?     @map("payment_methods")
  convertedToInvoiceId String?     @unique @map("converted_to_invoice_id") @db.Uuid
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  partner           Partner        @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  createdBy         User           @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  lines             QuoteLine[]
  convertedToInvoice Invoice?      @relation("quoteConversion", fields: [convertedToInvoiceId], references: [id], onDelete: SetNull)
  sourceInvoice     Invoice?       @relation("invoiceQuote")

  @@map("quotes")
}

model QuoteLine {
  id          String  @id @default(uuid()) @db.Uuid
  quoteId     String  @map("quote_id") @db.Uuid
  description String
  unit        String?
  quantity    Decimal @db.Decimal(12, 3)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 3)
  lineTotal   Decimal @map("line_total") @db.Decimal(12, 2)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@map("quote_lines")
}

model QuoteCounter {
  id         String @id @default(uuid()) @db.Uuid
  lastNumber Int    @default(0) @map("last_number")

  @@map("quote_counters")
}

enum PurchaseOrderStatus {
  draft
  sent
}

model PurchaseOrder {
  id              String               @id @default(uuid()) @db.Uuid
  orderNumber     String               @unique @map("order_number")
  supplierId      String               @map("supplier_id") @db.Uuid
  createdByUserId String               @map("created_by_user_id") @db.Uuid
  orderDate       DateTime             @default(now()) @map("order_date")
  status          PurchaseOrderStatus  @default(draft)
  subtotal        Decimal              @db.Decimal(12, 2)
  discountPercent Decimal              @default(0) @map("discount_percent") @db.Decimal(5, 2)
  discountAmount  Decimal              @default(0) @map("discount_amount") @db.Decimal(12, 2)
  tvaAmount       Decimal              @map("tva_amount") @db.Decimal(12, 2)
  totalAmount     Decimal              @map("total_amount") @db.Decimal(12, 2)
  paymentMethods       Json?            @map("payment_methods")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  supplier  Partner               @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy User                  @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  lines     PurchaseOrderLine[]

  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id               String  @id @default(uuid()) @db.Uuid
  purchaseOrderId  String  @map("purchase_order_id") @db.Uuid
  description      String
  unit             String?
  quantity         Decimal @db.Decimal(12, 3)
  unitPrice        Decimal @map("unit_price") @db.Decimal(12, 3)
  lineTotal        Decimal @map("line_total") @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@map("purchase_order_lines")
}

model PurchaseOrderCounter {
  id         String @id @default(uuid()) @db.Uuid
  lastNumber Int    @default(0) @map("last_number")

  @@map("purchase_order_counters")
}

model Company {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  logoUrl      String?  @map("logo_url")
  siegeSocial  String?  @map("siege_social")
  ville        String?  @map("ville")
  mobile       String?
  telFax       String?  @map("tel_fax")
  rc           String?  @map("rc")
  nif          String?  @map("nif")
  ain          String?  @map("ain")
  banqueBaraka String?  @map("banque_baraka")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("companies")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}
