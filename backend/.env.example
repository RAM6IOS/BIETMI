# ==============================
# BIETMI ERP — Backend Environment
# ==============================

# قاعدة البيانات (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/bietmi_db?schema=public"

# المنفذ
PORT=3000

# بيئة التشغيل
NODE_ENV=development

# JWT (سيُستخدم لاحقاً في Sprint Auth)
JWT_SECRET=change_me_to_a_strong_secret
JWT_EXPIRES_IN=7d

# كلمة مرور المستخدم admin_bietmi عند Seed (اختياري —如果不设定سيكون عشوائياً)
ADMIN_PASSWORD=admin123
