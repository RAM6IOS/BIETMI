# ==============================
# BIETMI ERP — Backend Environment
# ==============================

# قاعدة البيانات (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/bietmi_db?schema=public"

# المنفذ
PORT=3000

# بيئة التشغيل
NODE_ENV=development

# JWT
JWT_SECRET=change_me_to_a_strong_secret
JWT_EXPIRES_IN=8h

# كلمة مرور المستخدم admin_bietmi عند Seed (اختياري — إذا لم تُحدد ستكون عشوائية)
ADMIN_PASSWORD=admin123

# ==============================
# SMTP / البريد الإلكتروني (مطلوب لاسترجاع كلمة المرور)
# في بيئة التطوير يُستخدم Ethereal (بريد وهمي) إذا لم تُضبط هذه المتغيرات
# ⚠️ في الإنتاج (NODE_ENV=production) يجب ضبط SMTP_HOST وإلا يرفض التطبيق البدء
# ==============================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-password
MAIL_FROM="BIETMI ERP" <noreply@bietmi.local>

# رابط الواجهة الأمامية (يُستخدم في رابط استرجاع كلمة المرور بالإيميل)
# يجب ضبطه على رابط الإنتاج الفعلي حتى يكون رابط الاستعادة صالحاً
FRONTEND_URL=http://localhost:5173
